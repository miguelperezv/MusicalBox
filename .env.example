# Credenciales de MercadoPago
# Obtén las tuyas en: https://www.mercadopago.com.co/developers/panel
MERCADOPAGO_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE
MERCADOPAGO_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE

# Otras variables de entorno
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///musicalbox.sqlite3

# Spotify (client credentials; buscar y refrescar metadatos de lanzamientos)
# Crea una app en: https://developer.spotify.com/dashboard (sin necesidad de autorizar usuarios)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Configuración de correo (ejemplo para Gmail)
# MAIL_BACKEND=smtp
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_USE_TLS=true
# MAIL_FROM=Musical Box <your-email@gmail.com>

# Avisos al admin por Telegram (ver app/telegram.py)
# Crea un bot con @BotFather para obtener TG_BOT_TOKEN; el chat_id se obtiene con @userinfobot
# (o haciendo GET a https://api.telegram.org/bot<TOKEN>/getUpdates después de escribirle al bot).
# TG_BACKEND: real (por defecto) | consola | memoria | off. Sin credenciales cae a consola.
# TG_BACKEND=real
# TG_BOT_TOKEN=
# TG_ADMIN_CHAT_ID=

# Avisos al admin por WhatsApp / Meta Cloud API (segundo canal, ver app/whatsapp.py)
# 1) Crea una app en developers.facebook.com y activa el producto "WhatsApp".
# 2) En "WhatsApp -> API Setup" obtén el WA_PHONE_NUMBER_ID y el token (WA_ACCESS_TOKEN).
# 3) El número que recibirá avisos (WA_ADMIN_PHONE_NUMBER) debe ser el número de prueba de Meta
#    en desarrollo o un número aprobado para la app (en "Phone numbers").
# 4) Registra el webhook https://TU_DOMINIO/whatsapp/webhook en Meta usando WA_WEBHOOK_VERIFY_TOKEN.
# WA_BACKEND: real (por defecto) | consola | memoria | off. Sin credenciales cae a consola.
# El webhook solo acepta comandos («enviado <nº>», «revisada <nº>») desde los números de WA_ADMIN_PHONE_NUMBER.
# WA_BACKEND=real
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_API_VERSION=v21.0
# WA_ADMIN_PHONE_NUMBER=573001234567
# WA_WEBHOOK_VERIFY_TOKEN=