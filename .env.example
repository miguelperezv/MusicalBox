# Credenciales de MercadoPago
# Obtén las tuyas en: https://www.mercadopago.com.co/developers/panel
MERCADOPAGO_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE
MERCADOPAGO_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE

# Otras variables de entorno
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///musicalbox.sqlite3

# Spotify (client credentials; buscar y refrescar metadatos de lanzamientos)
# Crea una app en: https://developer.spotify.com/dashboard (sin necesidad de autorizar usuarios)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Configuración de correo (ejemplo para Gmail)
# MAIL_BACKEND=smtp
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_USE_TLS=true
# MAIL_FROM=Musical Box <your-email@gmail.com>

# Avisos al admin por Telegram (ver app/telegram.py)
# Crea un bot con @BotFather para obtener TG_BOT_TOKEN; el chat_id se obtiene con @userinfobot
# (o haciendo GET a https://api.telegram.org/bot<TOKEN>/getUpdates después de escribirle al bot).
# TG_BACKEND: real (por defecto) | consola | memoria | off. Sin credenciales cae a consola.
# TG_BACKEND=real
# TG_BOT_TOKEN=
# TG_ADMIN_CHAT_ID=

# Bot de cotización por Telegram (ver app/telegram.py): el webhook /telegram-bot/webhook
# solo responde a TG_ADMIN_CHAT_ID y exige este secreto como ?secret_token=
# (en desarrollo se registra con GET /telegram-bot/configure)
# TG_WEBHOOK_SECRET=

# URL base pública para callbacks de pagos (PSE, etc.)
# En local: usa ngrok/cloudflared -> PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
# PUBLIC_BASE_URL=